<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Settings.SettingsPage"
             Title="{DynamicResource SettingsTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource Language}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding Languages}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedLanguage}"
                        WidthRequest="170"
                        SemanticProperties.Description="{DynamicResource Language}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource Theme}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding Themes}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedTheme}"
                        WidthRequest="170"
                        SemanticProperties.Description="{DynamicResource Theme}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource DateFormat}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding DateFormats}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedDateFormat}"
                        WidthRequest="170"
                        SemanticProperties.Description="{DynamicResource DateFormat}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource WeightUnit}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding WeightUnits}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedWeightUnit}"
                        WidthRequest="170"
                        SemanticProperties.Description="{DynamicResource WeightUnit}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource HeightUnit}" VerticalOptions="Center" />
                <Picker Grid.Column="1"
                        ItemsSource="{Binding HeightUnits}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        SelectedItem="{Binding SelectedHeightUnit}"
                        WidthRequest="170"
                        SemanticProperties.Description="{DynamicResource HeightUnit}" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
