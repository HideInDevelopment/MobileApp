<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Settings.SettingsPage"
             Title="{DynamicResource SettingsTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource Language}" VerticalOptions="Center" />
                <Grid Grid.Column="1" WidthRequest="170">
                    <Button Text="{Binding SelectedLanguageDisplayName}"
                            Style="{StaticResource SelectorButton}"
                            Clicked="OnLanguageSelectorClicked"
                            SemanticProperties.Description="{DynamicResource Language}" />
                    <Label Style="{StaticResource DropdownArrow}" />
                </Grid>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource Theme}" VerticalOptions="Center" />
                <Grid Grid.Column="1" WidthRequest="170">
                    <Button Text="{Binding SelectedTheme.DisplayName}"
                            Style="{StaticResource SelectorButton}"
                            Clicked="OnThemeSelectorClicked"
                            SemanticProperties.Description="{DynamicResource Theme}" />
                    <Label Style="{StaticResource DropdownArrow}" />
                </Grid>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource DateFormat}" VerticalOptions="Center" />
                <Grid Grid.Column="1" WidthRequest="170">
                    <Button Text="{Binding SelectedDateFormat.DisplayName}"
                            Style="{StaticResource SelectorButton}"
                            Clicked="OnDateFormatSelectorClicked"
                            SemanticProperties.Description="{DynamicResource DateFormat}" />
                    <Label Style="{StaticResource DropdownArrow}" />
                </Grid>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Grid.Column="0" Text="{DynamicResource MeasurementSystem}" VerticalOptions="Center" />
                <Grid Grid.Column="1" WidthRequest="170">
                    <Button Text="{Binding SelectedMeasurementSystem.DisplayName}"
                            Style="{StaticResource SelectorButton}"
                            Clicked="OnMeasurementSystemSelectorClicked"
                            SemanticProperties.Description="{DynamicResource MeasurementSystem}" />
                    <Label Style="{StaticResource DropdownArrow}" />
                </Grid>
            </Grid>
            <Label Text="{DynamicResource PremiumRequired}"
                   IsVisible="{Binding IsMeasurementSystemLocked}"
                   Style="{StaticResource SecondaryText}" />
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{DynamicResource ReminderSettings}" Style="{StaticResource CardTitle}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="{DynamicResource DailyReminder}" VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsDailyReminderEnabled, Mode=OneWay}"
                                Toggled="OnDailyReminderToggled"
                                SemanticProperties.Description="{DynamicResource DailyReminder}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="{DynamicResource ReminderTime}" VerticalOptions="Center" />
                        <TimePicker Grid.Column="1"
                                    Time="{Binding ReminderTime, Mode=TwoWay}"
                                    Format="HH:mm"
                                    SemanticProperties.Description="{DynamicResource ReminderTime}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="{DynamicResource InactivityReminder}" VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsInactivityReminderEnabled, Mode=OneWay}"
                                Toggled="OnInactivityReminderToggled"
                                SemanticProperties.Description="{DynamicResource InactivityReminder}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0" Text="{DynamicResource InactivityReminderInterval}" VerticalOptions="Center" />
                        <Grid Grid.Column="1" WidthRequest="170">
                            <Button Text="{Binding SelectedInactivityInterval.DisplayName}"
                                    Style="{StaticResource SelectorButton}"
                                    Clicked="OnInactivityIntervalSelectorClicked"
                                    SemanticProperties.Description="{DynamicResource InactivityReminderInterval}" />
                            <Label Style="{StaticResource DropdownArrow}" />
                        </Grid>
                    </Grid>
                    <Label Text="{Binding ReminderStatus}"
                           IsVisible="{Binding HasReminderStatus}"
                           Style="{StaticResource SecondaryText}"
                           SemanticProperties.Description="{DynamicResource ReminderPermissionRequired}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
