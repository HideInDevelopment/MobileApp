<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Profiles.ProfileEditorPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{DynamicResource ProfileName}" />
            <Entry Text="{Binding Name}" Placeholder="{DynamicResource ProfileName}" ClearButtonVisibility="WhileEditing" />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                <Label Grid.Row="0" Text="{DynamicResource Height}" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding HeightText}" Keyboard="Numeric" Placeholder="{DynamicResource Cm}" WidthRequest="150" />
                <Label Grid.Row="1" Text="{DynamicResource Age}" VerticalOptions="Center" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding AgeText}" Keyboard="Numeric" Placeholder="{DynamicResource Years}" WidthRequest="150" />
                <Label Grid.Row="2" Text="{DynamicResource Gender}" VerticalOptions="Center" />
                <Picker Grid.Row="2" Grid.Column="1" ItemsSource="{Binding GenderOptions}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedGender}" WidthRequest="150" />
                <Label Grid.Row="3" Text="{DynamicResource ActivityLevel}" VerticalOptions="Center" />
                <Picker Grid.Row="3" Grid.Column="1" ItemsSource="{Binding ActivityLevels}" ItemDisplayBinding="{Binding DisplayName}" SelectedItem="{Binding SelectedActivityLevel}" WidthRequest="150" />
            </Grid>
            <Label Text="{Binding ValidationMessage}" TextColor="Red" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" />
            <Button Text="{DynamicResource Save}" Command="{Binding SaveCommand}" MinimumHeightRequest="48" />
            <Button Text="{DynamicResource Cancel}" Command="{Binding CancelCommand}" MinimumHeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
