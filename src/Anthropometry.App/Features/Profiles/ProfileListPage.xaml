<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Anthropometry.App.Features.Profiles"
             x:Class="Anthropometry.App.Features.Profiles.ProfileListPage"
             x:Name="RootPage"
             Title="{DynamicResource ProfilesTitle}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{DynamicResource SettingsLabel}"
                     IconImageSource="{AppThemeBinding Light=settings.svg, Dark=settings_dark.svg}"
                     Command="{Binding SettingsCommand}"
                     SemanticProperties.Description="{DynamicResource SettingsLabel}" />
        <ToolbarItem Text="{DynamicResource HelpLabel}"
                     IconImageSource="{AppThemeBinding Light=help.svg, Dark=help_dark.svg}"
                     Command="{Binding HelpCommand}"
                     SemanticProperties.Description="{DynamicResource HelpLabel}" />
    </ContentPage.ToolbarItems>
    <Grid Padding="20" RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <VerticalStackLayout Grid.Row="0" IsVisible="{Binding IsLoading}" Spacing="8">
            <ActivityIndicator IsRunning="{Binding IsLoading}" />
            <Label Text="{DynamicResource LoadingProfiles}" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" IsVisible="{Binding IsEmpty}" Spacing="12" VerticalOptions="Center">
            <Label Text="{DynamicResource NoProfileYet}" FontSize="20" HorizontalOptions="Center" />
            <Label Text="{DynamicResource CreateOneToGetStarted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
            <Button Text="{DynamicResource CreateProfile}" Command="{Binding CreateCommand}" MinimumHeightRequest="48" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" IsVisible="{Binding IsEmpty, Converter={StaticResource InverseBoolConverter}}">
            <CollectionView ItemsSource="{Binding Profiles}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="0,4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <local:ProfileRowView Grid.Column="0" BindingContext="{Binding}" />
                            <Button Grid.Column="1" Text="{DynamicResource OpenProfile}" Style="{StaticResource SecondaryButton}" Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.SelectCommand}" CommandParameter="{Binding}" MinimumHeightRequest="48" SemanticProperties.Description="{DynamicResource OpenProfile}" />
                            <Button Grid.Column="2" Text="{DynamicResource DeleteProfile}" Style="{StaticResource DestructiveButton}" Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding}" MinimumHeightRequest="48" SemanticProperties.Description="{DynamicResource DeleteProfile}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" VerticalOptions="End" />

            <VerticalStackLayout Grid.Row="2" Spacing="8">
                <Button Text="{DynamicResource AddProfile}"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding CreateCommand}"
                    IsVisible="{Binding HasProfiles}"
                    HorizontalOptions="Fill"
                    MinimumHeightRequest="48" />
                <Button Text="{DynamicResource ImportProfile}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ImportCommand}"
                    HorizontalOptions="Fill"
                    MinimumHeightRequest="48" />
            </VerticalStackLayout>
    </Grid>
</ContentPage>
