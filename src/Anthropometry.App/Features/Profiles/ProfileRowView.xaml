<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Profiles.ProfileRowView">
    <Border Style="{StaticResource CardBorder}" Padding="12" MinimumHeightRequest="72">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Label Grid.Column="0"
                   Text="{Binding Gender, Converter={StaticResource GenderIconConverter}}"
                   FontSize="28"
                   WidthRequest="40"
                   HorizontalTextAlignment="Center"
                   VerticalOptions="Center"
                   SemanticProperties.Description="{DynamicResource Gender}" />
            <Label Grid.Column="1"
                   Text="{Binding Name}"
                   Style="{StaticResource CardTitle}"
                   VerticalOptions="Center"
                   SemanticProperties.Description="{Binding Name}" />
        </Grid>
    </Border>
</ContentView>
