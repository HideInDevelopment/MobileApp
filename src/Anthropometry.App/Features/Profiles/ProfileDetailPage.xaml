<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Profiles.ProfileDetailPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding ErrorMessage}" TextColor="Red" IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
            <ActivityIndicator IsRunning="{Binding IsLoading}" />
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <Label Text="{DynamicResource EstimateDisclaimer}" Style="{StaticResource SecondaryText}" />
            </Border>
            <Button Text="{DynamicResource AddMeasurements}" Style="{StaticResource PrimaryButton}" Command="{Binding AddMeasurementsCommand}" MinimumHeightRequest="48" />
            <Button Text="{DynamicResource AddWeight}" Style="{StaticResource PrimaryButton}" Command="{Binding AddWeightCommand}" IsEnabled="{Binding CanAddWeight}" MinimumHeightRequest="48" />
            <Button Text="{DynamicResource EditProfile}" Style="{StaticResource SecondaryButton}" Command="{Binding EditCommand}" MinimumHeightRequest="48" />
            <Button Text="{DynamicResource History}" Style="{StaticResource SecondaryButton}" Command="{Binding HistoryCommand}" MinimumHeightRequest="48" />
            <Button Text="{DynamicResource ExportProfile}"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ExportCommand}"
                    IsVisible="{Binding IsExportLocked, Converter={StaticResource InverseBoolConverter}}"
                    MinimumHeightRequest="48" />
            <Button Text="{DynamicResource ExportProfile}"
                    Style="{StaticResource LockedButton}"
                    Command="{Binding ExportCommand}"
                    IsVisible="{Binding IsExportLocked}"
                    MinimumHeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
