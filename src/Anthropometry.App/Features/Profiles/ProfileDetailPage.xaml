<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Profiles.ProfileDetailPage"
             Title="{Binding Profile.Name}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding Profile.Name}" FontSize="28" FontAttributes="Bold" />
            <Label Text="Measurements and results are estimates, not medical diagnoses." />
            <Button Text="Edit profile" Command="{Binding EditCommand}" MinimumHeightRequest="48" />
            <Button Text="History" Command="{Binding HistoryCommand}" MinimumHeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
