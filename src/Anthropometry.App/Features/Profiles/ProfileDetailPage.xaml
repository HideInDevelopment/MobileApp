<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Profiles.ProfileDetailPage"
             Title="{Binding Profile.Name}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Label Text="{Binding Profile.Name}" FontSize="28" FontAttributes="Bold" />
            <HorizontalStackLayout Spacing="8">
                <Label Text="⚠"
                       IsVisible="{Binding ShowWarningIcon}"
                       TextColor="Orange"
                       SemanticProperties.Description="Some profile measurements need to be updated." />
                <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            </HorizontalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsLoading}" />
            <Label Text="Measurements and results are estimates, not medical diagnoses." />
            <Button Text="Add weight" Command="{Binding AddWeightCommand}" MinimumHeightRequest="48" />
            <Button Text="Add measurements" Command="{Binding AddMeasurementsCommand}" MinimumHeightRequest="48" />
            <Button Text="Edit profile" Command="{Binding EditCommand}" MinimumHeightRequest="48" />
            <Button Text="History" Command="{Binding HistoryCommand}" MinimumHeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
