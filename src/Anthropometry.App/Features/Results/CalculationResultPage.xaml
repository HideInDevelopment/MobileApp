<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Results.CalculationResultPage"
             Title="{DynamicResource ResultsTitle}">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16">
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Label Text="{DynamicResource EstimatedResults}" FontSize="28" FontAttributes="Bold" />
            <Label Text="⚠"
                   IsVisible="{Binding ShowWarningIcon}"
                   TextColor="Orange"
                   SemanticProperties.Description="{DynamicResource ReusedMeasurementsDescription}" />
        </HorizontalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="1" Padding="16" Margin="0,4">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Value}" FontSize="24" />
                                <Label Text="{Binding Unit}" VerticalOptions="End" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsLoading}" />
        <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
