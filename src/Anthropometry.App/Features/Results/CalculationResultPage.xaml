<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Results.CalculationResultPage"
             Title="Results">
    <Grid Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <Label Grid.Row="0" Text="Estimated results" FontSize="28" FontAttributes="Bold" />
        <Label Grid.Row="1" Text="{Binding FormulaDetails}" FontSize="12" />
        <CollectionView Grid.Row="2" ItemsSource="{Binding Results}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeThickness="1" Padding="16" Margin="0,4">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding CalculationType}" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Value}" FontSize="24" />
                                <Label Text="{Binding Unit}" VerticalOptions="End" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding FormulaId}" FontSize="12" />
                            <Label Text="{Binding FormulaVersion, StringFormat='Formula version {0}'}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="2" IsRunning="{Binding IsLoading}" />
        <Label Grid.Row="2" Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
