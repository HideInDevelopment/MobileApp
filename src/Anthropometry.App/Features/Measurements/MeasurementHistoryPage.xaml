<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Measurements.MeasurementHistoryPage"
             Title="Measurement history">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16">
        <Label Grid.Row="0" Text="Measurement history" FontSize="28" FontAttributes="Bold" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Measurements}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label Text="No measurements yet" FontSize="20" HorizontalOptions="Center" />
                    <Label Text="Saved measurements and their results stay on this device." HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,6" StrokeThickness="1">
                        <Border.Shadow>
                            <Shadow Brush="#F2C94C" Offset="0,2" Radius="8" Opacity="0" />
                        </Border.Shadow>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ShowWarningIcon}" Value="True">
                                <Setter Property="Shadow">
                                    <Setter.Value>
                                        <Shadow Brush="#F2C94C" Offset="0,2" Radius="8" Opacity="0.75" />
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" IsVisible="False">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding ShowWarningIcon}" Value="False">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding DateText}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                <Label Text="{Binding Measurement.WeightKg, StringFormat='Weight: {0} kg'}" HorizontalTextAlignment="End" />
                                <Label Text="{Binding Measurement.HeightCm, StringFormat='Height: {0} cm'}" HorizontalTextAlignment="End" />
                                <Label Text="{Binding MeasurementTypeText}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="View results" IsVisible="{Binding CanViewResults}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}" CommandParameter="{Binding}" MinimumHeightRequest="48" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" IsVisible="False">
                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding ShowWarningIcon}" Value="True">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Grid.Triggers>
                            <Label Grid.Column="0"
                                   Text="⚠"
                                   TextColor="Orange"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="These results reuse the previous neck and abdomen measurements." />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="End">
                                <Label Text="{Binding DateText}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                <Label Text="{Binding Measurement.WeightKg, StringFormat='Weight: {0} kg'}" HorizontalTextAlignment="End" />
                                <Label Text="{Binding Measurement.HeightCm, StringFormat='Height: {0} cm'}" HorizontalTextAlignment="End" />
                                <Label Text="{Binding MeasurementTypeText}" HorizontalTextAlignment="End" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="View results" IsVisible="{Binding CanViewResults}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}" CommandParameter="{Binding}" MinimumHeightRequest="48" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" />
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
