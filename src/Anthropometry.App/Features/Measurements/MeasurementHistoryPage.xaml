<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Measurements.MeasurementHistoryPage"
             Title="{DynamicResource MeasurementHistory}">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16">
        <Label Grid.Row="0" Text="{DynamicResource MeasurementHistory}" FontSize="28" FontAttributes="Bold" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Measurements}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label Text="{DynamicResource NoMeasurements}" FontSize="20" HorizontalOptions="Center" />
                    <Label Text="{DynamicResource SavedMeasurementsLocal}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,6" StrokeThickness="1" BackgroundColor="{Binding RowBackgroundColor}">
                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="⚠"
                                   FontSize="36"
                                   TextColor="Orange"
                                   IsVisible="{Binding ShowWarningIcon}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="{DynamicResource ReusedMeasurementsDescription}" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Start">
                                <Label Text="{Binding DateText}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                                <Label Text="{Binding WeightText}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                                <Label Text="{Binding HeightText}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                                <Label Text="{Binding MeasurementTypeText}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="{DynamicResource ViewResults}" IsVisible="{Binding CanViewResults}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}" CommandParameter="{Binding}" MinimumHeightRequest="48" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" />
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
