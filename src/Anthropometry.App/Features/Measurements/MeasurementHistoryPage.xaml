<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Measurements.MeasurementHistoryPage"
             Title="{DynamicResource MeasurementHistory}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{DynamicResource Charts}"
                     IconImageSource="{AppThemeBinding Light=ruler.svg, Dark=ruler_dark.svg}"
                     Command="{Binding ChartsCommand}"
                     Order="Primary"
                     SemanticProperties.Description="{DynamicResource Charts}" />
        <ToolbarItem Text="{DynamicResource Filter}"
                     Command="{Binding ToggleFiltersCommand}"
                     Order="Secondary"
                     SemanticProperties.Description="{DynamicResource Filter}" />
    </ContentPage.ToolbarItems>
    <Grid>
        <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16">
        <Border Grid.Row="0"
                Style="{StaticResource CardBorder}"
                Padding="12"
                IsVisible="{Binding IsFilterPanelVisible}"
                StrokeThickness="1">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" IsChecked="{Binding UseFromDate}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{DynamicResource FromDate}" VerticalOptions="Center" />
                    <DatePicker Grid.Column="2" Date="{Binding FromDate}" IsEnabled="{Binding UseFromDate}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" IsChecked="{Binding UseToDate}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{DynamicResource ToDate}" VerticalOptions="Center" />
                    <DatePicker Grid.Column="2" Date="{Binding ToDate}" IsEnabled="{Binding UseToDate}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{DynamicResource MeasurementType}" VerticalOptions="Center" />
                    <Grid Grid.Column="1">
                        <Button Text="{Binding SelectedTypeOption.DisplayName}"
                                Style="{StaticResource SelectorButton}"
                                Clicked="OnMeasurementTypeSelectorClicked" />
                        <Label Style="{StaticResource DropdownArrow}" />
                    </Grid>
                </Grid>
                <Button Text="{DynamicResource ClearFilters}"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearFiltersCommand}"
                        IsVisible="{Binding HasActiveFilters}"
                        HorizontalOptions="Start"
                        MinimumHeightRequest="48" />
            </VerticalStackLayout>
        </Border>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Measurements}">
            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                    <Label Text="{Binding EmptyStateTitle}" FontSize="20" HorizontalOptions="Center" />
                    <Label Text="{Binding EmptyStateDescription}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource MeasurementHistoryRowBorder}" Padding="12" Margin="0,6">
                        <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="⚠"
                                   FontSize="36"
                                   TextColor="Orange"
                                   IsVisible="{Binding ShowWarningIcon}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   SemanticProperties.Description="{DynamicResource ReusedMeasurementsDescription}" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Start">
                                <Label Style="{StaticResource MeasurementHistoryRowText}" Text="{Binding DateText}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                                <Label Style="{StaticResource MeasurementHistoryRowText}" Text="{Binding WeightText}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                                <Label Style="{StaticResource MeasurementHistoryRowText}" Text="{Binding HeightText}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                                <Label Style="{StaticResource MeasurementHistoryRowText}" Text="{Binding MeasurementTypeText}" FontAttributes="Bold" HorizontalTextAlignment="Start" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Button Text="{DynamicResource ViewResults}" Style="{StaticResource PrimaryButton}" IsVisible="{Binding CanViewResults}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectCommand}" CommandParameter="{Binding}" MinimumHeightRequest="48" SemanticProperties.Description="{DynamicResource ViewResults}" />
                                <Button Text="{DynamicResource EditMeasurement}" Style="{StaticResource SecondaryButton}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditCommand}" CommandParameter="{Binding}" MinimumHeightRequest="48" SemanticProperties.Description="{DynamicResource EditMeasurement}" />
                                <Button Text="{DynamicResource DeleteMeasurement}" Style="{StaticResource DestructiveButton}" Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeleteCommand}" CommandParameter="{Binding}" MinimumHeightRequest="48" SemanticProperties.Description="{DynamicResource DeleteMeasurement}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" />
        <Label Grid.Row="1" Text="{Binding ErrorMessage}" TextColor="Red" HorizontalOptions="Center" VerticalOptions="Center" />
        </Grid>
        <Grid IsVisible="{Binding IsChartMenuVisible}"
              BackgroundColor="Transparent"
              ZIndex="10">
            <BoxView BackgroundColor="Transparent">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding DismissChartMenuCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border Style="{StaticResource CardBorder}"
                    WidthRequest="220"
                    Padding="8"
                    Margin="0,8,8,0"
                    HorizontalOptions="End"
                    VerticalOptions="Start">
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Opacity="0.3"
                            Radius="12"
                            Offset="0,4" />
                </Border.Shadow>
                <Button Text="{DynamicResource MetricChart}"
                        ImageSource="{AppThemeBinding Light=ruler.svg, Dark=ruler_dark.svg}"
                        ContentLayout="Left,8"
                        Command="{Binding WeightGraphicCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                        HorizontalOptions="Fill"
                        MinimumHeightRequest="48"
                        Padding="12,8"
                        CornerRadius="6"
                        SemanticProperties.Description="{DynamicResource MetricChart}" />
            </Border>
        </Grid>
    </Grid>
</ContentPage>
