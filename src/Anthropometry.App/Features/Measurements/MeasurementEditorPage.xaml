<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Measurements.MeasurementEditorPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="{DynamicResource ResultsEstimateDisclaimer}" />
            <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto" RowSpacing="10" ColumnSpacing="8">
                <Label Grid.Row="0" Text="{DynamicResource Weight}" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding WeightText}" Keyboard="Numeric" WidthRequest="150" />
                <Label Grid.Row="0" Grid.Column="2" Text="{Binding WeightUnitText}" VerticalOptions="Center" />
            </Grid>
            <Grid IsVisible="{Binding IsExtended}" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                <Label Grid.Row="0" Text="{DynamicResource Neck}" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding NeckText}" Keyboard="Text" WidthRequest="150" />
                <Label Grid.Row="0" Grid.Column="2" Text="{Binding LengthUnitText}" VerticalOptions="Center" />
                <Label Grid.Row="1" Text="{Binding TrunkLabel}" VerticalOptions="Center" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding AbdomenText}" Keyboard="Text" WidthRequest="150" />
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding LengthUnitText}" VerticalOptions="Center" />
                <Label Grid.Row="2" Text="{DynamicResource Hip}" IsVisible="{Binding IsFemale}" VerticalOptions="Center" />
                <Entry Grid.Row="2" Grid.Column="1" Text="{Binding HipText}" Keyboard="Text" IsVisible="{Binding IsFemale}" WidthRequest="150" />
                <Label Grid.Row="2" Grid.Column="2" Text="{Binding LengthUnitText}" IsVisible="{Binding IsFemale}" VerticalOptions="Center" />
            </Grid>
            <Label Text="{Binding ValidationMessage}" TextColor="Red" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" />
            <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" MinimumHeightRequest="48" />
            <Button Text="{DynamicResource Cancel}" Command="{Binding CancelCommand}" MinimumHeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
