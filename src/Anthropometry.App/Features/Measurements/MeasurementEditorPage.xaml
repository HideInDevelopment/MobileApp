<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Measurements.MeasurementEditorPage"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="{Binding Title}" FontSize="28" FontAttributes="Bold" />
            <Label Text="Results are estimates, not medical diagnoses." />
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto" RowSpacing="10" ColumnSpacing="8">
                <Label Grid.Row="0" Text="Weight" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding WeightText}" Keyboard="Numeric" Placeholder="kg" WidthRequest="150" />
            </Grid>
            <Grid IsVisible="{Binding IsExtended}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="8">
                <Label Grid.Row="0" Text="Neck" VerticalOptions="Center" />
                <Entry Grid.Row="0" Grid.Column="1" Text="{Binding NeckText}" Keyboard="Numeric" Placeholder="cm" WidthRequest="150" />
                <Label Grid.Row="1" Text="Abdomen" VerticalOptions="Center" />
                <Entry Grid.Row="1" Grid.Column="1" Text="{Binding AbdomenText}" Keyboard="Numeric" Placeholder="cm" WidthRequest="150" />
            </Grid>
            <Label Text="{Binding ValidationMessage}" TextColor="Red" />
            <Label Text="{Binding ErrorMessage}" TextColor="Red" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" />
            <Button Text="{Binding SaveButtonText}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" MinimumHeightRequest="48" />
            <Button Text="Cancel" Command="{Binding CancelCommand}" MinimumHeightRequest="48" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
