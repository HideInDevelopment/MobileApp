<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Measurements.WeightGraphicPage"
             Title="{DynamicResource WeightGraphicTitle}">
    <Grid Padding="20" RowDefinitions="*" RowSpacing="16">
        <Grid Grid.Row="0">
            <ScrollView Orientation="Horizontal"
                        IsVisible="{Binding HasPoints}"
                        HorizontalScrollBarVisibility="Always">
                <AbsoluteLayout x:Name="ChartContainer"
                                WidthRequest="{Binding ChartWidth}"
                                HeightRequest="360"
                                HorizontalOptions="Start"
                                VerticalOptions="Start">
                    <GraphicsView x:Name="WeightChart"
                                  WidthRequest="{Binding ChartWidth}"
                                  HeightRequest="360"
                                  HorizontalOptions="Start"
                                  StartInteraction="OnChartStartInteraction"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                                  AbsoluteLayout.LayoutFlags="All" />

                    <Border x:Name="LegendBubble"
                            IsVisible="{Binding IsLegendVisible}"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
                            Stroke="{StaticResource Primary}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            InputTransparent="True"
                            AbsoluteLayout.LayoutBounds="0,0,-1,-1"
                            AbsoluteLayout.LayoutFlags="None"
                            SizeChanged="OnLegendBubbleSizeChanged"
                            ZIndex="1">
                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.25"
                                    Radius="10"
                                    Offset="0,4" />
                        </Border.Shadow>
                        <Label Text="{Binding LegendText}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </AbsoluteLayout>
            </ScrollView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 Spacing="12"
                                 VerticalOptions="Center">
                <Label Text="{DynamicResource WeightGraphicNoMeasurements}"
                       FontSize="20"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </Grid>
    </Grid>
</ContentPage>
