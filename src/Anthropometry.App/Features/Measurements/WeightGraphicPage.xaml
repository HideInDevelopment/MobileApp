<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Measurements.WeightGraphicPage"
             Title="{DynamicResource MetricChartTitle}">
    <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16">
        <Border Grid.Row="0" Padding="12" StrokeThickness="1">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Grid.Column="0" Text="{DynamicResource ChartMetric}" VerticalOptions="Center" />
                    <Grid Grid.Column="1">
                        <Button Text="{Binding SelectedMetricOption.DisplayName}"
                                Style="{StaticResource SelectorButton}"
                                Clicked="OnMetricSelectorClicked" />
                        <Label Style="{StaticResource DropdownArrow}" />
                    </Grid>
                </Grid>
                <Button Text="{DynamicResource PremiumRequired}"
                        Command="{Binding ShowPremiumCommand}"
                        IsVisible="{Binding IsFullGraphicsLocked}"
                        Style="{StaticResource SecondaryButton}" />
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" IsChecked="{Binding UseFromDate}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{DynamicResource FromDate}" VerticalOptions="Center" />
                    <DatePicker Grid.Column="2" Date="{Binding FromDate}" IsEnabled="{Binding UseFromDate}" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <CheckBox Grid.Column="0" IsChecked="{Binding UseToDate}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{DynamicResource ToDate}" VerticalOptions="Center" />
                    <DatePicker Grid.Column="2" Date="{Binding ToDate}" IsEnabled="{Binding UseToDate}" />
                </Grid>
                <Button Text="{DynamicResource ClearFilters}"
                        Command="{Binding ClearDateRangeCommand}"
                        IsVisible="{Binding HasDateFilters}"
                        HorizontalOptions="Start"
                        MinimumHeightRequest="48" />
            </VerticalStackLayout>
        </Border>
        <Grid Grid.Row="1">
            <ScrollView Orientation="Horizontal"
                        IsVisible="{Binding HasPoints}"
                        HorizontalScrollBarVisibility="Always">
                <AbsoluteLayout x:Name="ChartContainer"
                                WidthRequest="{Binding ChartWidth}"
                                HeightRequest="360"
                                HorizontalOptions="Start"
                                VerticalOptions="Start">
                    <GraphicsView x:Name="WeightChart"
                                  WidthRequest="{Binding ChartWidth}"
                                  HeightRequest="360"
                                  HorizontalOptions="Start"
                                  StartInteraction="OnChartStartInteraction"
                                  AbsoluteLayout.LayoutBounds="0,0,1,1"
                                  AbsoluteLayout.LayoutFlags="All" />

                    <Border x:Name="LegendBubble"
                            IsVisible="{Binding IsLegendVisible}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                            Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Gray200}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,8"
                            HorizontalOptions="Start"
                            VerticalOptions="Start"
                            InputTransparent="True"
                            AbsoluteLayout.LayoutBounds="0,0,-1,-1"
                            AbsoluteLayout.LayoutFlags="None"
                            SizeChanged="OnLegendBubbleSizeChanged"
                            ZIndex="1">
                        <Border.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.25"
                                    Radius="10"
                                    Offset="0,4" />
                        </Border.Shadow>
                        <Label Text="{Binding LegendText}"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                    </Border>
                </AbsoluteLayout>
            </ScrollView>

            <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                 Spacing="12"
                                 VerticalOptions="Center">
                <Label Text="{Binding EmptyStateText}"
                       FontSize="20"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </Grid>
    </Grid>
</ContentPage>
