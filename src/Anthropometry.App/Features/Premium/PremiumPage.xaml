<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Anthropometry.App.Features.Premium.PremiumPage"
             Appearing="OnAppearing"
             Title="{DynamicResource PremiumTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource CardBorder}" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{DynamicResource PremiumTitle}" Style="{StaticResource CardTitle}" />
                    <Label Text="{Binding Description}" Style="{StaticResource SecondaryText}" />
                    <Label Text="{Binding StateText}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout Spacing="8">
                <Label Text="{DynamicResource PremiumFeatures}" Style="{StaticResource CardTitle}" />
                <Label Text="{DynamicResource PremiumFeatureProfiles}" />
                <Label Text="{DynamicResource PremiumFeatureUnits}" />
                <Label Text="{DynamicResource PremiumFeatureCharts}" />
                <Label Text="{DynamicResource PremiumFeatureTransfer}" />
                <Label Text="{DynamicResource PremiumFeaturePastMeasurements}" />
            </VerticalStackLayout>
            <Button Text="{DynamicResource PremiumSubscribe}"
                    Command="{Binding SubscribeCommand}"
                    IsVisible="{Binding IsPremium, Converter={StaticResource InverseBoolConverter}}"
                    MinimumHeightRequest="48" />
            <Button Text="{DynamicResource PremiumRestore}"
                    Command="{Binding RestoreCommand}"
                    MinimumHeightRequest="48" />
            <Button Text="{DynamicResource PremiumManageSubscription}"
                    Command="{Binding ManageSubscriptionCommand}"
                    IsVisible="{Binding IsPremium}"
                    MinimumHeightRequest="48" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
