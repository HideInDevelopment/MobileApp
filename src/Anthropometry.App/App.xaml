<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Anthropometry.App"
             xmlns:common="clr-namespace:Anthropometry.App.Common"
             x:Class="Anthropometry.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <common:InverseBoolConverter x:Key="InverseBoolConverter" />
            <common:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <common:GenderIconConverter x:Key="GenderIconConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
